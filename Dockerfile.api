FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
  && addgroup -S appgroup \
  && adduser -S appuser -G appgroup

COPY server ./server
COPY supabase/schemas ./supabase/schemas

EXPOSE 3001

USER appuser

CMD ["node", "server/index.js"]
